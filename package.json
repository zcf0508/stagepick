{
  "name": "stagepick-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "pnpm lint && pnpm typecheck && pnpm test",
    "release": "bumpp packages/core/package.json packages/cli/package.json --commit --tag --push"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^22.20.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
