#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

timestamp() {
  date '+%H:%M:%S'
}

run_step() {
  local name="$1"
  shift
  local started=$SECONDS
  printf '[%s] %s\n' "$(timestamp)" "$name"
  "$@"
  printf '[%s] %s completed in %ss\n' "$(timestamp)" "$name" "$((SECONDS - started))"
}

if ! command -v node >/dev/null 2>&1; then
  printf 'Node.js is required but was not found on PATH.\n' >&2
  exit 1
fi

if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 22 || (major === 22 && minor >= 18) ? 0 : 1)'; then
  printf 'Node.js 22.18 or newer is required; found %s.\n' "$(node --version)" >&2
  exit 1
fi

if ! command -v git >/dev/null 2>&1; then
  if ! command -v apt-get >/dev/null 2>&1; then
    printf 'git is required but was not found, and apt-get is unavailable.\n' >&2
    exit 1
  fi
  run_step 'install git' bash -c 'apt-get update && apt-get install -y git'
fi

package_manager="$(node -p 'JSON.parse(require("fs").readFileSync("package.json", "utf8")).packageManager')"
case "$package_manager" in
  pnpm@*)
    expected_pnpm="${package_manager#pnpm@}"
    ;;
  *)
    printf 'Unsupported packageManager in package.json: %s\n' "$package_manager" >&2
    exit 1
    ;;
esac

pnpm_command=(pnpm)
if ! command -v pnpm >/dev/null 2>&1 || [[ "$(pnpm --version 2>/dev/null || true)" != "$expected_pnpm" ]]; then
  if command -v corepack >/dev/null 2>&1; then
    run_step "activate pnpm@$expected_pnpm" corepack prepare "pnpm@$expected_pnpm" --activate
    if ! command -v pnpm >/dev/null 2>&1 || [[ "$(pnpm --version 2>/dev/null || true)" != "$expected_pnpm" ]]; then
      pnpm_command=(corepack pnpm)
    fi
  elif command -v npm >/dev/null 2>&1; then
    run_step "install pnpm@$expected_pnpm" npm install --global "pnpm@$expected_pnpm"
  else
    printf 'pnpm %s is required, but neither corepack nor npm is available.\n' "$expected_pnpm" >&2
    exit 1
  fi
fi

if [[ "${pnpm_command[*]}" == 'pnpm' ]] && [[ "$(pnpm --version)" != "$expected_pnpm" ]]; then
  printf 'Expected pnpm %s; found %s.\n' "$expected_pnpm" "$(pnpm --version)" >&2
  exit 1
fi

run_step 'install locked dependencies' "${pnpm_command[@]}" install --frozen-lockfile

printf '[%s] setup ready (Node %s, pnpm %s)\n' "$(timestamp)" "$(node --version)" "$expected_pnpm"
