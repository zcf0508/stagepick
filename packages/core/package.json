{
  "name": "@stagepick/core",
  "type": "module",
  "version": "0.1.2",
  "description": "Core library for stagepick: parse git diffs, select hunks and lines, build partial-staging patches",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcf0508/stagepick.git",
    "directory": "packages/core"
  },
  "keywords": [
    "git",
    "diff",
    "staging",
    "partial-staging",
    "ai-agents"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "execa": "^9.5.2"
  }
