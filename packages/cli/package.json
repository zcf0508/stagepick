{
  "name": "stagepick",
  "type": "module",
  "version": "0.1.2",
  "description": "Non-interactive git staging for AI agents and scripts: stage hunks or individual lines by stable content ids and file line numbers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcf0508/stagepick.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "git",
    "staging",
    "hunk",
    "partial-staging",
    "ai-agents",
    "cli"
  ],
  "bin": {
    "stagepick": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@stagepick/core": "workspace:*",
    "@toon-format/toon": "^4.1.1",
    "citty": "^0.1.6"
  }
}
